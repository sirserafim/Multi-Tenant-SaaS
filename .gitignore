# dependencies
node_modules/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# packages/contracts is source-only (no build step) — ignore accidental tsc emit
packages/contracts/src/**/*.js
packages/contracts/src/**/*.d.ts
packages/contracts/src/**/*.js.map
packages/contracts/src/**/*.d.ts.map

# environment variables (keep .env.example tracked)
.env
.env.*
!.env.example

# Supabase local artifacts
.branches
.temp
supabase/.temp/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS junk
.DS_Store
Thumbs.db
.vscode/
.idea/
