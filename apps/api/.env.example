# =============================================================================
# apps/api — Express telemetry API environment variables
# =============================================================================
# Copy to .env for local development. Never commit real secrets.
# ALL variables here are server-only — none are exposed to browsers.
# =============================================================================

# HTTP port for the Express server.
PORT=4000

# Comma-separated origins allowed by CORS (browser sends Origin header).
CORS_ORIGIN=http://localhost:3000

# Supabase project URL — server-side only in this app.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase anon key — used for read paths that must respect RLS as anon.
SUPABASE_ANON_KEY=your-anon-key
