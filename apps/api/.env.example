# =============================================================================
# apps/api — Express telemetry API environment variables
# =============================================================================
# Copy to .env for local development. Never commit real secrets.
# ALL variables here are server-only — none are exposed to browsers.
# =============================================================================

# HTTP port for the Express server.
PORT=4000

# Comma-separated origins allowed by CORS (browser sends Origin header).
# Never use "*".
CORS_ORIGIN=http://localhost:3000

# Direct Postgres URL for transactional writes (service role / bypass RLS).
# Local Supabase default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL — optional companion for future read paths.
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Max JSON body size for telemetry payloads.
JSON_BODY_LIMIT=32kb

# Rate limits (sliding window).
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW_MS=60000
