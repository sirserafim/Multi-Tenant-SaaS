# =============================================================================
# apps/web — Next.js frontend environment variables
# =============================================================================
# Copy to .env.local for local development. Never commit real secrets.
# Browser-safe vars MUST use the NEXT_PUBLIC_ prefix.
# =============================================================================

# --- Browser-safe (embedded in client bundle) ---------------------------------

# Supabase project URL — safe to expose; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose; RLS restricts what anon can read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical app origin for QR codes and absolute links (no trailing slash).
NEXT_PUBLIC_APP_URL=https://multi-tenant-saas.app

# Telemetry API base URL (browser calls this for engagement events).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Server-only (Next.js server components / route handlers) ----------------

# Supabase service role key — NEVER prefix with NEXT_PUBLIC_. Server-only.
# Bypasses RLS; used only in server-side mutations that cannot run as anon.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
